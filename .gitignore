# Build output — regenerated by `make`/`make dist`, never hand-edited
/bin/
/dist/
/bpf/*.o

# Installer build output — regenerated by installers/*/build_*.sh or Inno Setup
/*.pkg
/*.deb
/installers/windows/Output/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local env/secrets — never commit a real token
*.env
!scripts/sentryx.env.example
